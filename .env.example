# 复制为 .env 并填写真实值（.env 已在 .gitignore）

# ---- 基础设施 ----
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=anotify
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars
# 对外端口（nginx 反代到这里）
ANOTIFY_PORT=1003

# ---- 账号体系（openssl rand -base64 48 生成；pepper 一旦设定不可更改，否则所有密码失效）----
ANOTIFY_JWT_SECRET=
ANOTIFY_PASSWORD_PEPPER=
# web 前端地址：验证邮件 / agent 认领链接以它为前缀
ANOTIFY_WEB_URL=https://anotify.space
# 反代（nginx）写入 X-Real-IP / X-Forwarded-For 时设为 1
ANOTIFY_TRUST_PROXY=1

# ---- Mailgun（免费档每天 100 封）；留空则验证邮件只打印到服务端日志 ----
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# MAILGUN_FROM=Anotify <noreply@mg.anotify.space>
# 欧洲区账号改为 https://api.eu.mailgun.net
# MAILGUN_BASE_URL=https://api.mailgun.net
# ANOTIFY_MAIL_DAILY_LIMIT=100
